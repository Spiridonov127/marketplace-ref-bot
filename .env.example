# === Telegram (только для бота управления) ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_USER_IDS=12345678

# === Яндекс Дистрибуция (CPA) ===
YANDEX_DISTRIBUTION_PARTNER_ID=your_partner_id
YANDEX_DISTRIBUTION_API_KEY=your_api_key

# === ОРД (Оператор рекламных данных) ===
# Получить токен: https://ord.yandex.ru (бесплатно)
ORD_TOKEN=your_ord_token

# === Дзен ===
DZEN_CHANNEL_URL=https://dzen.ru/your_channel
DZEN_COOKIES_PATH=data/dzen_cookies.json

# === Настройки постинга ===
POSTS_PER_DAY=2
MIN_DISCOUNT_PERCENT=20
POST_INTERVAL_HOURS=8
MAX_PRODUCTS_PER_POST=3

# === Настройки парсинга ===
MAX_PRODUCTS_PER_PARSE=50
DB_PATH=data/marketplace.db
