# === MAX (бот управления, предпочтительно на ВПС — не блокируется с
# российских IP в отличие от Telegram) ===
# Токен создаётся в самом MAX: напишите @MasterBot, он попросит имя бота
# и пришлёт токен. MAX_ADMIN_USER_IDS можно оставить пустым при первом
# запуске — бот напечатает ваш user_id в лог при первом сообщении.
MAX_BOT_TOKEN=
MAX_ADMIN_USER_IDS=

# === Telegram (бот управления, альтернатива MAX — например, для запуска
# на домашнем компьютере, где Telegram не блокирован) ===
TELEGRAM_BOT_TOKEN=
ADMIN_USER_IDS=
# Нужно только при запуске с российского IP (например, наш VPS в Яндекс.
# Облаке) — там api.telegram.org заблокирован на уровне провайдера.
# Прокси через Cloudflare Worker, см. cloudflare-worker/src/worker.js.
# Оставьте пустым при запуске с домашнего компьютера.
TELEGRAM_API_URL=
# Тоже нужно только на ВПС: Яндекс Маркет капчит датацентровые IP (в т.ч.
# сам Yandex Cloud), поэтому трафик к market.yandex.ru заворачивается через
# SOCKS5-туннель до домашнего компьютера — socks5://127.0.0.1:1080, порт
# поднимает deploy/ym-proxy-tunnel.service на домашней машине. Пусто на
# самом домашнем компьютере (там и так свой IP).
YM_PROXY_URL=

# === Яндекс Дистрибуция (CPA) ===
YANDEX_DISTRIBUTION_PARTNER_ID=
YANDEX_DISTRIBUTION_API_KEY=

# === ОРД (Оператор рекламных данных) ===
ORD_TOKEN=

# === Дзен ===
DZEN_CHANNEL_URL=
DZEN_COOKIES_PATH=data/dzen_cookies.json
# Временно: ссылка на конкретный черновик в Дзен-студии (dzen.ru -> "+" -> Статья),
# вида https://dzen.ru/profile/editor/id/<channel_id>/<draft_id>/edit
DZEN_DRAFT_URL=

# === Настройки постинга ===
POSTS_PER_DAY=2
MIN_DISCOUNT_PERCENT=20
POST_INTERVAL_HOURS=8
MAX_PRODUCTS_PER_POST=3

# === Настройки парсинга ===
MAX_PRODUCTS_PER_PARSE=50
DB_PATH=data/marketplace.db
